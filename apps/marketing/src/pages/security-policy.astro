---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const sections = [
  ["scope", "Scope"],
  ["reporting", "Reporting security issues"],
  ["deployment", "Deployment responsibilities"],
] as const;
---

<LegalPage
  title="Security Policy | Loom"
  description="How to report security issues in Loom and secure self-hosted deployments."
  heading="Loom Security Policy"
  lede="Loom runs coding agents on your own machines. This page explains how to report vulnerabilities in this repository and how to harden self-hosted environments."
  effectiveDate="2026-11-23"
  lastUpdated="2026-11-23"
  sections={sections}
>
  <section id="scope">
    <p class="section-number">01</p>
    <h2>Scope</h2>
    <p>
      This policy covers the Loom server, web client, desktop app, and mobile app maintained at{" "}
      <a href={GITHUB_REPOSITORY_URL}>{GITHUB_REPOSITORY_URL}</a>. This fork does not operate a
      hosted web service or cloud relay.
    </p>
  </section>

  <section id="reporting">
    <p class="section-number">02</p>
    <h2>Reporting Security Issues</h2>
    <p>
      Please report suspected vulnerabilities privately via GitHub Security Advisories at{" "}
      <a href={`${GITHUB_REPOSITORY_URL}/security/advisories/new`}
        >{GITHUB_REPOSITORY_URL}/security/advisories/new</a
      >{" "}
      (or open an issue for non-sensitive hardening improvements). Include affected components,
      reproduction steps, and impact with any secrets redacted.
    </p>
  </section>

  <section id="deployment">
    <p class="section-number">03</p>
    <h2>Deployment Responsibilities</h2>
    <ul>
      <li>Keep the server bound to loopback unless fronted by TLS and network access controls.</li>
      <li>Use Managed Policy to cap agent permission modes and lock provider settings on managed machines.</li>
      <li>Protect local Loom data directories and host credentials; agents run as your OS user.</li>
    </ul>
  </section>
</LegalPage>
