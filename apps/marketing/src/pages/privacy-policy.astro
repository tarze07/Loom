---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const sections = [
  ["overview", "Overview"],
  ["local-data", "Data stored on your machine"],
  ["providers", "Third-party coding agents and providers"],
  ["telemetry", "Telemetry and external requests"],
  ["contact", "Contact"],
] as const;
---

<LegalPage
  title="Privacy Policy | Loom"
  description="How Loom handles data as an open-source, self-hosted control plane for coding agents."
  heading="Loom Privacy Policy"
  lede="Loom is open-source, self-hosted software. Your projects, threads, credentials, and logs stay on the machines you run Loom on."
  effectiveDate="2026-11-23"
  lastUpdated="2026-11-23"
  sections={sections}
>
  <section id="overview">
    <p class="section-number">01</p>
    <h2>Overview</h2>
    <p>
      This distribution of Loom is open-source software released under the MIT license at{" "}
      <a href={GITHUB_REPOSITORY_URL}>{GITHUB_REPOSITORY_URL}</a>. It does not operate a hosted
      account service, cloud relay, or centralized telemetry backend.
    </p>
  </section>

  <section id="local-data">
    <p class="section-number">02</p>
    <h2>Data Stored on Your Machine</h2>
    <p>
      The Loom server stores its SQLite database, attachments, logs, settings, and provider
      credentials locally inside your configured Loom data directory (by default{" "}
      <code>~/.loom/userdata</code>) and creates local git checkpoints inside your project
      repositories.
    </p>
  </section>

  <section id="providers">
    <p class="section-number">03</p>
    <h2>Third-Party Coding Agents and Providers</h2>
    <p>
      Loom drives coding-agent CLIs and providers that you install and authenticate yourself (such
      as Claude Code, Codex, Cursor, OpenCode, or custom gateways). Any prompts, files, or tool
      outputs sent to those providers are governed by the respective provider&apos;s privacy policy
      and terms.
    </p>
  </section>

  <section id="telemetry">
    <p class="section-number">04</p>
    <h2>Telemetry and External Requests</h2>
    <p>
      Loom does not include third-party product analytics or crash-reporting SDKs. OpenTelemetry
      export is opt-in and sends data only to endpoints you configure explicitly. Optional update
      checks and model-manifest refreshes can be disabled via server settings or Managed Policy.
    </p>
  </section>

  <section id="contact">
    <p class="section-number">05</p>
    <h2>Contact</h2>
    <p>
      Questions about this project can be opened at{" "}
      <a href={`${GITHUB_REPOSITORY_URL}/issues`}>{GITHUB_REPOSITORY_URL}/issues</a>.
    </p>
  </section>
</LegalPage>
