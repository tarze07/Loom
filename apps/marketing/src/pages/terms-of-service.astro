---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const sections = [
  ["license", "Open-source license"],
  ["self-hosted", "Self-hosted operation"],
  ["third-party", "Third-party tools and providers"],
  ["warranty", "Disclaimer of warranty"],
  ["contact", "Contact"],
] as const;
---

<LegalPage
  title="Terms of Service | Loom"
  description="Licensing and usage terms for the open-source Loom project."
  heading="Loom Terms"
  lede="Loom is open-source software licensed under the MIT License and run on infrastructure you control."
  effectiveDate="2026-11-23"
  lastUpdated="2026-11-23"
  sections={sections}
>
  <section id="license">
    <p class="section-number">01</p>
    <h2>Open-Source License</h2>
    <p>
      Loom is distributed under the MIT License. You may use, copy, modify, merge, publish, and
      distribute the software in accordance with the{" "}
      <a href={`${GITHUB_REPOSITORY_URL}/blob/main/LICENSE`}>LICENSE</a> file in the repository.
    </p>
  </section>

  <section id="self-hosted">
    <p class="section-number">02</p>
    <h2>Self-Hosted Operation</h2>
    <p>
      You run the Loom server and clients on your own machines and networks. You are responsible for
      securing host access, network boundaries, TLS termination, pairing credentials, and agent
      permission modes (including Managed Policy where applicable).
    </p>
  </section>

  <section id="third-party">
    <p class="section-number">03</p>
    <h2>Third-Party Tools and Providers</h2>
    <p>
      Loom integrates with external coding agents, version-control hosts, and APIs that you supply.
      Your use of those third-party services remains subject to their separate terms and
      subscription agreements.
    </p>
  </section>

  <section id="warranty">
    <p class="section-number">04</p>
    <h2>Disclaimer of Warranty</h2>
    <p>
      As stated in the MIT License, the software is provided &ldquo;as is&rdquo;, without warranty
      of any kind, express or implied. Coding agents can read, edit, and execute commands on your
      machine; review actions and configure appropriate permission limits before running them
      against sensitive workspaces.
    </p>
  </section>

  <section id="contact">
    <p class="section-number">05</p>
    <h2>Contact</h2>
    <p>
      Bug reports and questions can be submitted at{" "}
      <a href={`${GITHUB_REPOSITORY_URL}/issues`}>{GITHUB_REPOSITORY_URL}/issues</a>.
    </p>
  </section>
</LegalPage>
